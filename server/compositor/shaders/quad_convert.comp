// Quad layer promoted out of the eye images: resample one application swapchain
// image into the dedicated YCbCr encode image. Same colour maths as foveation.comp
// with an identity mapping, no foveation and no subgroup tricks: one invocation per
// chroma sample, so four luma samples and one chroma sample each.

#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1) uniform writeonly restrict image2D luma;
layout(set = 0, binding = 2) uniform writeonly restrict image2D chroma;

layout(push_constant) uniform quad_pc
{
	// Region of the source image to read, in normalized coordinates. A negative
	// height is how a bottom up (OpenGL) source is turned the right way up.
	vec4 src_rect;
	// Region of the encode image to fill, in pixels. Always starts at the origin,
	// always even; the rest of the image is filled with black so that it costs the
	// encoder as close to nothing as a constant area can.
	ivec2 dst_size;
	// Size of the encode image, in pixels
	ivec2 image_size;
}
pc;

const mat3 color_space = mat3(
        //         R        G        B
        /* Y */ 0.2126, 0.7152, 0.0722,
        /* Cb*/ -0.1146, -0.3854, 0.5,
        /* Cr*/ 0.5, -0.4542, -0.0458);

vec3 rgb_to_ycbcr(vec3 color)
{
	return transpose(color_space) * color + vec3(0, 0.5, 0.5);
}

float from_linear_to_srgb_channel(float value)
{
	if (value < 0.0031308)
		return 12.92 * value;
	return 1.055 * pow(value, 1.0 / 2.4) - 0.055;
}

vec3 from_linear_to_srgb(vec3 linear_rgb)
{
	return vec3(
	        from_linear_to_srgb_channel(linear_rgb.r),
	        from_linear_to_srgb_channel(linear_rgb.g),
	        from_linear_to_srgb_channel(linear_rgb.b));
}

// Colour of one luma sample, in YCbCr. Outside the filled region the picture is
// black, which is also what the headset would sample if it ever read there.
vec3 sample_at(ivec2 pixel)
{
	if (pixel.x >= pc.dst_size.x || pixel.y >= pc.dst_size.y)
		return vec3(0, 0.5, 0.5);

	vec2 uv = pc.src_rect.xy + ((vec2(pixel) + 0.5) / vec2(pc.dst_size)) * pc.src_rect.zw;

	// The source is sampled through an sRGB view, so what comes back is linear
	// and has to be encoded again before the YCbCr conversion, exactly as the
	// foveation pass does for the eye images.
	return rgb_to_ycbcr(from_linear_to_srgb(texture(source, uv).rgb));
}

void main()
{
	ivec2 c = ivec2(gl_GlobalInvocationID.xy);
	ivec2 p = c * 2;
	if (p.x >= pc.image_size.x || p.y >= pc.image_size.y)
		return;

	vec3 c00 = sample_at(p + ivec2(0, 0));
	vec3 c10 = sample_at(p + ivec2(1, 0));
	vec3 c01 = sample_at(p + ivec2(0, 1));
	vec3 c11 = sample_at(p + ivec2(1, 1));

	imageStore(luma, p + ivec2(0, 0), vec4(c00.x));
	imageStore(luma, p + ivec2(1, 0), vec4(c10.x));
	imageStore(luma, p + ivec2(0, 1), vec4(c01.x));
	imageStore(luma, p + ivec2(1, 1), vec4(c11.x));

	vec3 mean = (c00 + c10 + c01 + c11) * 0.25;
	imageStore(chroma, c, vec4(mean.y, mean.z, 0, 0));
}
