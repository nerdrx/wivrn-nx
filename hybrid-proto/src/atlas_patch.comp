#version 450
// Base-layer patch -> atlas, in the coded sample domain (ADR-0029 Cheat 7).
//
// Reads the MediaCodec AHardwareBuffer through a VkSamplerYcbcrConversion set
// to RGB_IDENTITY + NEAREST + full range, so the sampler performs NO colour
// conversion: .r/.g/.b come back as the raw Y/Cb/Cr samples the HEVC decoder
// wrote. The YCbCr -> R'G'B' -> YCoCg-R step is then done here in integer
// arithmetic, which is what ADR-0029 requires to be normative (the sampler's
// own conversion is not bit-exact across vendors; a plane fetch is).
//
// One workgroup column of 4x4 groups per 64x64 tile; gl_WorkGroupID.z indexes
// the tile list, so a partial refresh dispatches only the tiles it refreshes.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D baseTex;    // immutable ycbcr sampler
layout(set = 0, binding = 1, r8ui)  uniform uimage2D atlasY;
layout(set = 0, binding = 2, rg16i) uniform iimage2D atlasC;
layout(set = 0, binding = 3, std430) readonly buffer Tiles { ivec2 origin[]; } tiles;

layout(push_constant) uniform PC {
	ivec2 baseSize;   // luma extent of the decoded base picture
	int   nTiles;
	int   planes;     // 1 = luma only, 3 = luma + chroma
} pc;

// BT.709 full-range YCbCr -> R'G'B', Q16 fixed point, integer and exact.
// R = Y + 1.5748 (Cr-128); G = Y - 0.1873(Cb-128) - 0.4681(Cr-128);
// B = Y + 1.8556 (Cb-128).
const int K_R_CR =  103206; // 1.5748 * 65536
const int K_G_CB =  -12276; // -0.1873 * 65536
const int K_G_CR =  -30679; // -0.4681 * 65536
const int K_B_CB =  121609; // 1.8556 * 65536

ivec3 ycbcr_to_rgb(int y, int cb, int cr)
{
	int dcb = cb - 128, dcr = cr - 128;
	int r = y + ((K_R_CR * dcr + 32768) >> 16);
	int g = y + ((K_G_CB * dcb + K_G_CR * dcr + 32768) >> 16);
	int b = y + ((K_B_CB * dcb + 32768) >> 16);
	return clamp(ivec3(r, g, b), 0, 255);
}

// YCoCg-R, the reversible lifting (ADR-0012's display-format reference).
// Co, Cg get one extra bit; Y stays 8-bit.
ivec3 rgb_to_ycocgr(ivec3 c)
{
	int co = c.r - c.b;
	int t  = c.b + (co >> 1);
	int cg = c.g - t;
	int y  = t + (cg >> 1);
	return ivec3(y, co, cg);
}

int fetch_y(ivec2 p)
{
	vec2 uv = (vec2(p) + 0.5) / vec2(pc.baseSize);
	return int(texture(baseTex, uv).r * 255.0 + 0.5);
}

ivec3 fetch_ycbcr(ivec2 p)
{
	vec2 uv = (vec2(p) + 0.5) / vec2(pc.baseSize);
	vec3 s = texture(baseTex, uv).rgb;
	return ivec3(s * 255.0 + 0.5);
}

void main()
{
	int t = int(gl_WorkGroupID.z);
	if (t >= pc.nTiles)
		return;
	ivec2 org = tiles.origin[t];
	ivec2 lp = ivec2(gl_LocalInvocationID.xy) + ivec2(gl_WorkGroupID.xy) * 16;
	ivec2 p = org + lp;
	if (any(greaterThanEqual(p, pc.baseSize)))
		return;

	if (pc.planes == 1)
	{
		imageStore(atlasY, p, uvec4(fetch_y(p), 0, 0, 0));
		return;
	}
	// diagnostic modes: write one raw sampler channel, unconverted, so the
	// swizzle the driver reports can be identified against the reference decode
	if (pc.planes < 0)
	{
		vec3 raw = texture(baseTex, (vec2(p) + 0.5) / vec2(pc.baseSize)).rgb;
		float v = pc.planes == -1 ? raw.r : (pc.planes == -2 ? raw.g : raw.b);
		imageStore(atlasY, p, uvec4(uint(v * 255.0 + 0.5), 0, 0, 0));
		return;
	}

	// MEASURED on the Pico 4 (Adreno 650, driver externalFormat 506): the
	// driver's samplerYcbcrConversionComponents is NOT identity -- the sampled
	// .r/.g/.b come back as Cr/Y/Cb. Verified bit-exact against the reference
	// decode, 0 of 1183744 samples differing, on all three channels. A
	// normative conversion clause MUST consume this swizzle rather than assume
	// (Y, Cb, Cr), because getting it wrong produces a plausible picture.
	ivec3 s = fetch_ycbcr(p);
	ivec3 ycc = rgb_to_ycocgr(ycbcr_to_rgb(s.g, s.b, s.r));
	imageStore(atlasY, p, uvec4(uint(clamp(ycc.x, 0, 255)), 0, 0, 0));

	// 4:2:0 chroma: one Co/Cg pair per 2x2 luma quad, written by its top-left
	if ((p.x & 1) == 0 && (p.y & 1) == 0)
		imageStore(atlasC, p >> 1, ivec4(ycc.y, ycc.z, 0, 0));
}
